"use strict";

document.addEventListener("DOMContentLoaded", () => {
    initSpinner();
    initAnimations();
    initStickyNavbar();
    initBackToTop();
    initHeaderCarousel();
    initCounters();
    initTestimonialsCarousel();
});

/**
 * Spinner
 */
function initSpinner() {
    window.setTimeout(() => {
        const spinner = document.getElementById("spinner");

        if (spinner) {
            spinner.classList.remove("show");
        }
    }, 100);
}

/**
 * Animações substituindo WOW.js
 */
function initAnimations() {
    const elements = document.querySelectorAll(".wow");

    if (!elements.length) {
        return;
    }

    if (!("IntersectionObserver" in window)) {
        elements.forEach((element) => {
            element.classList.add("animated");
        });
        return;
    }

    const observer = new IntersectionObserver(
        (entries, observerInstance) => {
            entries.forEach((entry) => {
                if (!entry.isIntersecting) {
                    return;
                }

                const element = entry.target;
                const delay = element.dataset.wowDelay;

                if (delay) {
                    element.style.animationDelay = delay;
                }

                element.classList.add("animated");

                observerInstance.unobserve(element);
            });
        },
        {
            threshold: 0.15
        }
    );

    elements.forEach((element) => observer.observe(element));
}

/**
 * Navbar fixa
 */
function initStickyNavbar() {
    const stickyElements = document.querySelectorAll(".sticky-top");

    if (!stickyElements.length) {
        return;
    }

    const updateNavbar = () => {
        const shouldStick = window.scrollY > 300;

        stickyElements.forEach((element) => {
            element.classList.toggle("shadow-sm", shouldStick);
            element.style.top = shouldStick ? "0px" : "-150px";
        });
    };

    window.addEventListener("scroll", updateNavbar, {
        passive: true
    });

    updateNavbar();
}

/**
 * Botão voltar ao topo
 */
function initBackToTop() {
    const buttons = document.querySelectorAll(".back-to-top");

    if (!buttons.length) {
        return;
    }

    const updateVisibility = () => {
        const visible = window.scrollY > 100;

        buttons.forEach((button) => {
            button.style.display = visible ? "block" : "none";
        });
    };

    buttons.forEach((button) => {
        button.addEventListener("click", (event) => {
            event.preventDefault();

            window.scrollTo({
                top: 0,
                behavior: "smooth"
            });
        });
    });

    window.addEventListener("scroll", updateVisibility, {
        passive: true
    });

    updateVisibility();
}

/**
 * Carousel do cabeçalho
 * Substitui OwlCarousel.
 */
function initHeaderCarousel() {
    const carousel = document.querySelector(".header-carousel");

    if (!carousel) {
        return;
    }

    createSimpleCarousel(carousel, {
        autoplay: true,
        interval: 5000
    });
}

/**
 * Counter Up
 * Substitui jquery.counterup.
 */
function initCounters() {
    const counters = document.querySelectorAll(
        '[data-toggle="counter-up"]'
    );

    if (!counters.length) {
        return;
    }

    if (!("IntersectionObserver" in window)) {
        counters.forEach((counter) => {
            counter.textContent = counter.textContent.trim();
        });
        return;
    }

    const observer = new IntersectionObserver(
        (entries, observerInstance) => {
            entries.forEach((entry) => {
                if (!entry.isIntersecting) {
                    return;
                }

                animateCounter(entry.target);
                observerInstance.unobserve(entry.target);
            });
        },
        {
            threshold: 0.5
        }
    );

    counters.forEach((counter) => observer.observe(counter));
}

/**
 * Animação numérica
 */
function animateCounter(element) {
    const target = Number(
        element.textContent.replace(/[^\d.-]/g, "")
    );

    if (!Number.isFinite(target)) {
        return;
    }

    const duration = 2000;
    const start = performance.now();

    const update = (currentTime) => {
        const elapsed = currentTime - start;
        const progress = Math.min(elapsed / duration, 1);

        const easedProgress =
            1 - Math.pow(1 - progress, 3);

        const currentValue = Math.floor(
            target * easedProgress
        );

        element.textContent = currentValue.toLocaleString(
            "pt-BR"
        );

        if (progress < 1) {
            requestAnimationFrame(update);
        } else {
            element.textContent = target.toLocaleString(
                "pt-BR"
            );
        }
    };

    requestAnimationFrame(update);
}

/**
 * Testimonials
 * Substitui OwlCarousel.
 */
function initTestimonialsCarousel() {
    const carousel = document.querySelector(
        ".testimonial-carousel"
    );

    if (!carousel) {
        return;
    }

    createSimpleCarousel(carousel, {
        autoplay: false,
        interval: 5000,
        responsive: {
            0: 1,
            768: 2,
            992: 3
        }
    });
}

/**
 * Carousel simples em JavaScript puro.
 */
function createSimpleCarousel(container, options = {}) {
    const items = Array.from(
        container.children
    );

    if (items.length <= 1) {
        return;
    }

    let currentIndex = 0;
    let intervalId = null;

    const getVisibleItems = () => {
        const responsive = options.responsive;

        if (!responsive) {
            return 1;
        }

        const width = window.innerWidth;
        let visible = 1;

        Object.keys(responsive)
            .map(Number)
            .sort((a, b) => a - b)
            .forEach((breakpoint) => {
                if (width >= breakpoint) {
                    visible = responsive[breakpoint];
                }
            });

        return visible;
    };

    const render = () => {
        const visibleItems = getVisibleItems();

        items.forEach((item, index) => {
            const relativeIndex =
                (index - currentIndex + items.length) %
                items.length;

            const visible =
                relativeIndex < visibleItems;

            item.style.display = visible
                ? ""
                : "none";
        });
    };

    const next = () => {
        const visibleItems = getVisibleItems();

        currentIndex =
            (currentIndex + 1) % items.length;

        if (
            currentIndex >
            items.length - visibleItems
        ) {
            currentIndex = 0;
        }

        render();
    };

    const previous = () => {
        const visibleItems = getVisibleItems();

        if (
            currentIndex === 0 ||
            currentIndex >
                items.length - visibleItems
        ) {
            currentIndex =
                Math.max(
                    items.length - visibleItems,
                    0
                );
        } else {
            currentIndex--;
        }

        render();
    };

    const createNavigation = () => {
        const navigation =
            document.createElement("div");

        navigation.className =
            "carousel-navigation";

        const previousButton =
            document.createElement("button");

        previousButton.type = "button";
        previousButton.className =
            "carousel-prev";
        previousButton.setAttribute(
            "aria-label",
            "Anterior"
        );
        previousButton.innerHTML =
            '<i class="bi bi-chevron-left"></i>';

        const nextButton =
            document.createElement("button");

        nextButton.type = "button";
        nextButton.className =
            "carousel-next";
        nextButton.setAttribute(
            "aria-label",
            "Próximo"
        );
        nextButton.innerHTML =
            '<i class="bi bi-chevron-right"></i>';

        previousButton.addEventListener(
            "click",
            previous
        );

        nextButton.addEventListener(
            "click",
            next
        );

        navigation.appendChild(
            previousButton
        );

        navigation.appendChild(
            nextButton
        );

        container.parentElement?.appendChild(
            navigation
        );
    };

    render();
    createNavigation();

    if (options.autoplay) {
        intervalId = window.setInterval(
            next,
            options.interval || 5000
        );

        container.addEventListener(
            "mouseenter",
            () => {
                window.clearInterval(intervalId);
            }
        );

        container.addEventListener(
            "mouseleave",
            () => {
                intervalId = window.setInterval(
                    next,
                    options.interval || 5000
                );
            }
        );
    }

    window.addEventListener(
        "resize",
        render
    );
}

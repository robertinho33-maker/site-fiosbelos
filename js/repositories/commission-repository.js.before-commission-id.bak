/**
 * Commission Repository — V1
 *
 * Responsabilidade:
 * - consultar comissão;
 * - criar comissão;
 * - atualizar comissão;
 * - sincronizar comissão + pedido;
 * - registrar auditoria atomicamente.
 *
 * Este módulo NÃO decide regras de negócio.
 * Apenas persiste dados já validados pelo Service.
 */

import { db } from "../firebase-config.js";

import {
    collection,
    doc,
    getDoc,
    updateDoc,
    writeBatch,
    serverTimestamp
} from "https://www.gstatic.com/firebasejs/10.8.0/firebase-firestore.js";


const COMMISSIONS_COLLECTION = "commissions";
const ORDERS_COLLECTION = "orders";
const AUDIT_COLLECTION = "orderAudit";


/**
 * Cria comissão + auditoria atomicamente.
 */
export async function createCommissionWithAudit(
    commission,
    auditEvent
) {

    if (
        !commission ||
        typeof commission !== "object"
    ) {
        throw new Error(
            "Dados da comissão inválidos."
        );
    }

    if (
        !auditEvent ||
        typeof auditEvent !== "object"
    ) {
        throw new Error(
            "Evento de auditoria inválido."
        );
    }

    const commissionRef = doc(
        collection(db, COMMISSIONS_COLLECTION)
    );

    const auditRef = doc(
        collection(db, AUDIT_COLLECTION)
    );

    const batch = writeBatch(db);

    batch.set(
        commissionRef,
        {
            ...commission,
            createdAt:
                commission.createdAt ||
                serverTimestamp(),
            updatedAt:
                commission.updatedAt ||
                serverTimestamp()
        }
    );

    batch.set(
        auditRef,
        {
            ...auditEvent,
            commissionId: commissionRef.id,
            createdAt:
                auditEvent.createdAt ||
                serverTimestamp()
        }
    );

    await batch.commit();

    return {
        commission: {
            id: commissionRef.id,
            ...commission
        },

        audit: {
            id: auditRef.id,
            ...auditEvent,
            commissionId: commissionRef.id
        }
    };
}


/**
 * Busca comissão.
 */
export async function getCommission(
    commissionId
) {

    if (!commissionId) {
        throw new Error(
            "ID da comissão não informado."
        );
    }

    const commissionRef = doc(
        db,
        COMMISSIONS_COLLECTION,
        commissionId
    );

    const snapshot = await getDoc(
        commissionRef
    );

    if (!snapshot.exists()) {
        return null;
    }

    return {
        id: snapshot.id,
        ...snapshot.data()
    };
}


/**
 * Atualiza comissão sem auditoria.
 *
 * Mantido para operações internas compatíveis
 * com versões anteriores.
 */
export async function updateCommission(
    commissionId,
    changes
) {

    if (!commissionId) {
        throw new Error(
            "ID da comissão não informado."
        );
    }

    if (
        !changes ||
        typeof changes !== "object"
    ) {
        throw new Error(
            "Alterações da comissão inválidas."
        );
    }

    const commissionRef = doc(
        db,
        COMMISSIONS_COLLECTION,
        commissionId
    );

    await updateDoc(
        commissionRef,
        {
            ...changes,
            updatedAt: serverTimestamp()
        }
    );

    return getCommission(
        commissionId
    );
}


/**
 * Atualiza comissão + pedido + auditoria
 * dentro de UMA ÚNICA operação batch.
 *
 * Responsabilidade:
 * - atualizar commissions/{commissionId};
 * - atualizar orders/{orderId}.commission;
 * - registrar orderAudit;
 * - garantir atomicidade.
 *
 * O Repository NÃO decide se a transição é válida.
 */
export async function updateCommissionWithAudit(
    commissionId,
    changes,
    auditEvent,
    orderId = null,
    orderCommissionChanges = null
) {

    if (!commissionId) {
        throw new Error(
            "ID da comissão não informado."
        );
    }

    if (
        !changes ||
        typeof changes !== "object"
    ) {
        throw new Error(
            "Alterações da comissão inválidas."
        );
    }

    if (
        !auditEvent ||
        typeof auditEvent !== "object"
    ) {
        throw new Error(
            "Evento de auditoria inválido."
        );
    }

    if (!orderId) {
        throw new Error(
            "ID do pedido não informado para sincronização da comissão."
        );
    }

    if (
        !orderCommissionChanges ||
        typeof orderCommissionChanges !== "object"
    ) {
        throw new Error(
            "Alterações da comissão no pedido inválidas."
        );
    }


    const commissionRef = doc(
        db,
        COMMISSIONS_COLLECTION,
        commissionId
    );

    const orderRef = doc(
        db,
        ORDERS_COLLECTION,
        orderId
    );

    const auditRef = doc(
        collection(db, AUDIT_COLLECTION)
    );


    const batch = writeBatch(db);


    // =====================================================
    // 1. ATUALIZA COMISSÃO OPERACIONAL
    // =====================================================

    batch.update(
        commissionRef,
        {
            ...changes,
            updatedAt: serverTimestamp()
        }
    );


    // =====================================================
    // 2. SINCRONIZA SNAPSHOT DA COMISSÃO NO PEDIDO
    // =====================================================

    batch.update(
        orderRef,
        {
            ...orderCommissionChanges,
            updatedAt: serverTimestamp()
        }
    );


    // =====================================================
    // 3. REGISTRA AUDITORIA
    // =====================================================

    batch.set(
        auditRef,
        {
            ...auditEvent,
            commissionId,
            orderId,
            createdAt:
                auditEvent.createdAt ||
                serverTimestamp()
        }
    );


    // =====================================================
    // 4. COMMIT ATÔMICO
    // =====================================================

    await batch.commit();


    const updatedCommission =
        await getCommission(
            commissionId
        );


    return {
        commission: updatedCommission,

        audit: {
            id: auditRef.id,
            ...auditEvent,
            commissionId,
            orderId
        }
    };
}

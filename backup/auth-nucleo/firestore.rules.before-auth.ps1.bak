rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Regras para Pedidos
    match /orders/{orderId} {
      allow read, write: if true;
    }

    // Auditoria operacional dos pedidos
    match /orderAudit/{auditId} {
      allow read, write: if true;
    }

    // Regras para Clientes
    match /customers/{customerId} {
      allow read, write: if true;
    }

    // Regras para Cupons
    match /coupons/{couponId} {
      allow read, write: if true;
    }

    // Regras para Comissões
    match /commissions/{commissionId} {
      allow read, write: if true;
    }

    // Contador sequencial dos pedidos
    match /counters/{counterId} {
      allow read, write: if true;
    }

    // Estoque operacional
    
    match /inventory/{sku} {
      allow read: if isMaster();

      allow create: if isMaster()
        && request.resource.data.sku == sku
        && request.resource.data.quantity is int
        && request.resource.data.quantity >= 0;

      allow update: if isMaster()
        && request.resource.data.sku == sku
        && request.resource.data.quantity is int
        && request.resource.data.quantity >= 0;

      allow delete: if isMaster();
    }
  }
}


